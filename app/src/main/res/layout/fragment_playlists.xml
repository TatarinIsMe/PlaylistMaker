<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/icon_margin"
    android:paddingEnd="@dimen/icon_margin"
    android:paddingTop="24dp"
    android:paddingBottom="@dimen/icon_margin"
    tools:context=".presentation.media.PlaylistsFragment">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/new_playlist"
        android:textAllCaps="false"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="16sp"
        android:textColor="@color/colorBackground"
        android:backgroundTint="?attr/colorOnBackground"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:cornerRadius="20dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaylists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:itemCount="4"
            tools:listitem="@layout/item_playlist" />

        <LinearLayout
            android:id="@+id/llPlaylistsPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search_nothing_120" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/ys_display_medium"
                android:gravity="center"
                android:text="@string/playlists_placeholder"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
